{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "S3AccessForHydroponicsBucket",
			"Effect": "Allow",
			"Action": [
				"s3:ListBucket",
				"s3:GetBucketLocation",
				"s3:GetBucketNotification",
				"s3:PutBucketNotification"
			],
			"Resource": "arn:aws:s3:::hydroponics-data-project-2026"
		},
		{
			"Sid": "S3ObjectAccessForHydroponicsBucket",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:DeleteObject"
			],
			"Resource": "arn:aws:s3:::hydroponics-data-project-2026/*"
		},
		{
			"Sid": "DatabricksAutoLoaderSNSPermissions",
			"Effect": "Allow",
			"Action": [
				"sns:GetTopicAttributes",
				"sns:Subscribe",
				"sns:Unsubscribe"
			],
			"Resource": "arn:aws:sns:us-east-1:818783924384:csms-topic-by-path-0a2827583635056a0ba15f55874c1db01c1f22020a9c4723e26c680c51d5d36b"
		},
		{
			"Sid": "DatabricksAutoLoaderSQSPermissions",
			"Effect": "Allow",
			"Action": [
				"sqs:CreateQueue",
				"sqs:DeleteQueue",
				"sqs:GetQueueAttributes",
				"sqs:GetQueueUrl",
				"sqs:SetQueueAttributes",
				"sqs:ReceiveMessage",
				"sqs:DeleteMessage",
				"sqs:TagQueue"
			],
			"Resource": "arn:aws:sqs:us-east-1:818783924384:*"
		}
	]
}
